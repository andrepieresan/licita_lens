{
  "name": "licitalens-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "demo": "EXPO_PUBLIC_DEMO_MODE=true expo start",
    "demo:web": "EXPO_PUBLIC_DEMO_MODE=true expo start --web",
    "commercial:web": "EXPO_PUBLIC_API_URL=http://localhost:8080 expo start --web",
    "commercial:device": "bash scripts/commercial-device.sh",
    "typecheck": "tsc --noEmit",
    "generate:sdk": "openapi-typescript ../licitalens-backend/api/openapi.yaml -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.22",
    "expo-auth-session": "~57.0.12",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.18",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "openapi-typescript": "^7.9.1",
    "typescript": "~6.0.3"
  }
}
