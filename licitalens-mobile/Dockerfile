FROM oven/bun:1.3.14 AS build
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .
ARG EXPO_PUBLIC_API_URL=/api
ARG EXPO_PUBLIC_LEGAL_OPERATOR_NAME
ARG EXPO_PUBLIC_LEGAL_OPERATOR_DOCUMENT
ARG EXPO_PUBLIC_LEGAL_SUPPORT_EMAIL
ARG EXPO_PUBLIC_LEGAL_PRIVACY_EMAIL
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL
ENV EXPO_PUBLIC_LEGAL_OPERATOR_NAME=$EXPO_PUBLIC_LEGAL_OPERATOR_NAME
ENV EXPO_PUBLIC_LEGAL_OPERATOR_DOCUMENT=$EXPO_PUBLIC_LEGAL_OPERATOR_DOCUMENT
ENV EXPO_PUBLIC_LEGAL_SUPPORT_EMAIL=$EXPO_PUBLIC_LEGAL_SUPPORT_EMAIL
ENV EXPO_PUBLIC_LEGAL_PRIVACY_EMAIL=$EXPO_PUBLIC_LEGAL_PRIVACY_EMAIL
RUN bunx expo export --platform web

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/self-hosted/nginx.conf /etc/nginx/conf.d/default.conf
