# Copiado para .env.commercial.local na primeira execução de make commercial-up.
# Não versione .env.commercial.local (pode conter chaves Stripe reais).

# true = headers demo-user + Postgres real (recomendado para validar admin/billing localmente)
# false = exige JWT Keycloak e banco persistente. O gateway falha ao iniciar se
# faltarem DATABASE_URL, origens permitidas, chave admin e Stripe completo.
DEMO_MODE=true

ADMIN_API_KEY=local-commercial-admin

KEYCLOAK_ISSUER=http://localhost:8180/realms/licitalens
KEYCLOAK_AUDIENCE=licitalens-mobile

ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006

# Stripe (opcional — checkout/portal retornam 503 sem STRIPE_SECRET_KEY)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ESSENTIAL=
STRIPE_PRICE_PRO=
STRIPE_SUCCESS_URL=http://localhost:8082
STRIPE_CANCEL_URL=http://localhost:8082
STRIPE_PORTAL_RETURN_URL=http://localhost:8082
STRIPE_WEBHOOK_SECRET=
