POSTGRES_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_USER=licitalens
MINIO_ROOT_PASSWORD=replace-with-a-different-long-random-password
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_API_KEY=replace-with-a-long-random-admin-key
PUBLIC_SIGNUP=false
ALLOWED_ORIGINS=http://localhost:8080
APP_BASE_URL=http://localhost:8080
COOKIE_SECURE=false
HTTP_PORT=8080
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_DOCUMENT=
LEGAL_SUPPORT_EMAIL=
LEGAL_PRIVACY_EMAIL=
BACKUP_STATUS_DIR=./backups
BACKUP_STATUS_FILE=/backups/last-success
SYNC_INTERVAL=5m
PNCP_INITIAL_DAYS=7
PNCP_LOOKBACK_DAYS=2
PNCP_MAX_RECOVERY_DAYS=30
PNCP_RECENT_PAGES=3
PNCP_MODALITIES=6
PNCP_REQUEST_TIMEOUT=30s
PNCP_MAX_ATTEMPTS=3
PNCP_RETRY_DELAY=500ms

# Optional AI explanations for procurement opportunities. Keep the API key local.
# Use AI_PROVIDER=openai with OPENAI_API_KEY, or AI_PROVIDER=ollama with Ollama running on the host.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TEXT_MODEL=gemma3

# Configure all fields below to enable e-mail alerts.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS_MODE=auto
SMTP_TIMEOUT=15s
