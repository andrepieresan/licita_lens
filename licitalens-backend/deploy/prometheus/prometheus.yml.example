global:
  scrape_interval: 30s
  evaluation_interval: 30s

rule_files:
  - /etc/prometheus/licitalens-alerts.yml

scrape_configs:
  - job_name: licitalens-gateway
    metrics_path: /api/metrics
    static_configs:
      - targets: [web:8080]
  - job_name: licitalens-ingestion
    static_configs:
      - targets: [ingestion:8080]
  - job_name: licitalens-procurement
    static_configs:
      - targets: [procurement:8080]
  - job_name: licitalens-notifications
    static_configs:
      - targets: [notifications:8080]
  - job_name: licitalens-billing
    static_configs:
      - targets: [billing:8080]
