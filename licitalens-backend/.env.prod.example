# Referência para a operação cloud/staging. Guarde os valores reais em um secret manager.
# Não é a distribuição self-hosted; use deploy/self-hosted/.env.example para essa finalidade.

SKIP_DEMO_SEED=1
DEPLOYMENT_MODE=cloud
DEMO_MODE=false

DATABASE_URL=postgres://licitalens:REPLACE_WITH_REAL_PASSWORD@postgres:5432/licitalens

ADMIN_API_KEY=REPLACE_WITH_LONG_RANDOM_ADMIN_KEY
AUTH_JWT_SECRET=REPLACE_WITH_LONG_RANDOM_JWT_SECRET
ALLOWED_ORIGINS=https://app.seudominio.com

# Opcional: deixe em branco para usar o login próprio.
KEYCLOAK_ISSUER=
KEYCLOAK_AUDIENCE=
KEYCLOAK_PUBLIC_HOST=
PUBLIC_SIGNUP=true

# HTTPS é obrigatório fora do ambiente local; use o seu proxy/rede gerenciada.

SYNC_INTERVAL=5m
PNCP_RECENT_PAGES=5
PNCP_MODALITIES=6
PNCP_REQUEST_TIMEOUT=30s
PNCP_MAX_ATTEMPTS=3
PNCP_RETRY_DELAY=500ms

SMTP_HOST=smtp.seudominio.com
SMTP_PORT=587
SMTP_FROM=alertas@seudominio.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT=15s
APP_BASE_URL=https://app.seudominio.com

# Caminho montado no gateway; escreva RFC3339 somente após copiar o conjunto completo de backup.
BACKUP_STATUS_FILE=/var/lib/licitalens/backups/last-success

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIAL=
STRIPE_PRICE_PRO=
STRIPE_SUCCESS_URL=https://app.seudominio.com/plano
STRIPE_CANCEL_URL=https://app.seudominio.com/plano
STRIPE_PORTAL_RETURN_URL=https://app.seudominio.com/plano
STRIPE_RECONCILE_INTERVAL=1h

AI_PROVIDER=openai
OPENAI_API_KEY=
