# Copie para .env.prod.local no servidor (não versionar).
# Use com: docker compose -f compose.yaml -f compose.commercial.yaml -f compose.prod.yaml --env-file .env.prod.local

SKIP_DEMO_SEED=1
DEMO_MODE=true

DATABASE_URL=postgres://licitalens:CHANGE_ME@postgres:5432/licitalens

ADMIN_API_KEY=CHANGE_ME_LONG_RANDOM
AUTH_JWT_SECRET=CHANGE_ME_LONG_RANDOM
ALLOWED_ORIGINS=https://app.seudominio.com

KEYCLOAK_ISSUER=https://auth.seudominio.com/realms/licitalens
KEYCLOAK_AUDIENCE=licitalens-mobile
KEYCLOAK_PUBLIC_HOST=auth.seudominio.com

# Proxy: deploy/nginx/README.md (host ou serviço nginx no compose.prod)

SYNC_INTERVAL=5m
PNCP_RECENT_PAGES=5
PNCP_MODALITIES=6

SMTP_HOST=smtp.seudominio.com
SMTP_PORT=587
SMTP_FROM=alertas@seudominio.com
SMTP_USER=
SMTP_PASSWORD=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIAL=
STRIPE_PRICE_PRO=
STRIPE_SUCCESS_URL=https://app.seudominio.com/plano
STRIPE_CANCEL_URL=https://app.seudominio.com/plano
STRIPE_PORTAL_RETURN_URL=https://app.seudominio.com/plano

AI_PROVIDER=openai
OPENAI_API_KEY=
